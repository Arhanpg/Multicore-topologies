//
// Flow control
//

num_vcs     = 16;
vc_buf_size = 8;

wait_for_tail_credit = 1;


vc_allocator = islip; 
sw_allocator = islip;
alloc_iters  = 2;

credit_delay   = 2;
routing_delay  = 0;
vc_alloc_delay = 1;
sw_alloc_delay = 1;
st_final_delay = 1;

input_speedup     = 1;
output_speedup    = 1;
internal_speedup  = 1.0;

//
// Traffic
//

sim_type = latency;

warmup_periods = 3;

sample_period  = 1000;  

sim_count          = 1;



//topoogy

topology = mesh;
k  = 8;
n  = 2;
//
// Routing


routing_function = dor;

packet_size = 1;

use_read_write = 0;

traffic       = uniform;

injection_rate = 0.2;




END Configuration File: /mnt/f/Multicore/booksim2/runfiles/meshconfig
